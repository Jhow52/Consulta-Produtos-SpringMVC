<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
               http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
               http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/mvc
               http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!--
        Habilita o uso de anotacoes do Spring MVC
        como @Controller, @GetMapping, @Autowired, etc.
    -->
    <mvc:annotation-driven/>

    <!--
        Diz ao Spring para procurar automaticamente
        as classes anotadas dentro do pacote com.br.loja
    -->
    <context:component-scan base-package="com.br.loja"/>

    <!--
        ViewResolver: quando o Controller retornar o nome "index",
        o Spring vai procurar o arquivo /WEB-INF/views/index.jsp
    -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/"/>
        <property name="suffix" value=".jsp"/>
    </bean>

    <!--
        DataSource: configuracao da conexao com o banco MySQL.
        ALTERE username e password para os seus dados.
    -->
    <bean id="dataSource"
          class="org.springframework.jdbc.datasource.DriverManagerDataSource">
        <property name="driverClassName" value="com.mysql.cj.jdbc.Driver"/>
        <property name="url" value="jdbc:mysql://localhost:3306/loja"/>
        <property name="username" value="root"/>
        <property name="password" value="root"/>
    </bean>

    <!--
        JdbcTemplate: ferramenta do Spring que facilita
        executar SQL sem precisar abrir/fechar conexao manualmente.
        Usa o dataSource configurado acima.
    -->
    <bean id="jdbcTemplate"
          class="org.springframework.jdbc.core.JdbcTemplate">
        <property name="dataSource" ref="dataSource"/>
    </bean>

</beans>